# =============================================================================
# Starling Monorepo — Shared Configuration
# =============================================================================
# Copy this file to .env and modify as needed.
# App-specific settings go in apps/vllm-server/.env or apps/burn-server/.env

# =============================================================================
# HuggingFace Authentication
# =============================================================================

# HuggingFace token for model downloads (Voxtral requires access request)
# Get yours at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxx

# =============================================================================
# Shared Model Storage
# =============================================================================

# Shared model cache directory (used by all apps)
# Default: ./models/cache (relative to repo root)
# Both vllm-server and burn-server read from this directory
STARLING_MODELS_DIR=./models/cache

# =============================================================================
# OCR Server (apps/ocr-server — defaults shown)
# =============================================================================

# OCR_PORT=8092
# OCR_VLLM_OCR_PORT=8003            # GLM-OCR vLLM subprocess
# OCR_VLLM_EXTRACT_PORT=8004        # extraction LLM vLLM subprocess
# OCR_ENGINE=glm-ocr                # default OCR engine; mock for tests/CI
# OCR_EXTRACT_MODEL=qwen3-8b-fp8
# OCR_EXTRACT_AUTO=1                # run stage-2 extraction automatically
# OCR_ENGINE_IDLE_UNLOAD_SECS=0     # 0 = keep OCR engine warm (no ~35s cold boot); >0 releases ~5 GiB after idle
# OCR_EXTRACT_IDLE_UNLOAD_SECS=0    # 0 = keep extractor warm (no ~66s cold boot charged to the next extraction)
# OCR_ENGINE_PREWARM=1              # boot the default OCR engine at startup (background, non-blocking)
# OCR_LAYOUT_DEVICE=cuda            # PP-DocLayout-V3 stage: cuda ≈0.9s/page, cpu ≈1.4s (frees ~1.5 GiB)
# OCR_EXTRACT_NGRAM=1              # ngram speculative decoding on the extractor — ~2.4x faster JSON, exact output
# OCR_EXTRACT_NGRAM_TOKENS=5       # speculative tokens per step (higher = more draft, more waste on novel values)
# OCR_GPU_UTIL_OCR=0.20
# OCR_GPU_UTIL_EXTRACT=0.55         # 0.45 leaves <1 GiB KV after the FP8 weights
# OCR_RASTER_DPI=200
# OCR_LANGUAGE_HINT=bg,en
# OCR_TESSERACT_BIN=                # empty = auto (PATH, then ~/.local/tesseract)

# =============================================================================
# WebRTC / ICE Configuration (shared by all apps)
# =============================================================================

# Public IP for WebRTC ICE candidates (auto-detected if not set)
# Required for NAT traversal when server is behind a router
# PUBLIC_IP=192.168.1.100

# TURN server for strict NAT traversal (optional)
# TURN_SERVER=turn:your-turn-server:3478
# TURN_USERNAME=user
# TURN_PASSWORD=pass

# COTURN ephemeral credentials (shared secret mode)
# When set, overrides static TURN_USERNAME/TURN_PASSWORD
# TURN_SHARED_SECRET=

# Force TURN relay mode (use when direct/STUN connectivity fails)
FORCE_RELAY=false
